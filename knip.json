{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "components/ui/*.tsx",
    "scripts/*.mjs",
    "packages/cli/index.mjs",
    "stories/**/*.stories.tsx",
    ".rnstorybook/*.{ts,tsx}",
    "nativewind/components/ui/*.tsx"
  ],
  "project": [
    "components/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "packages/cli/**/*.mjs",
    ".rnstorybook/**/*.{ts,tsx}",
    "stories/**/*.tsx",
    "*.{ts,tsx}",
    "nativewind/**/*.tsx"
  ],
  "ignoreDependencies": ["expo-updates"]
}
